// The game at https://neonstickfight.com (see README, "Hosting" and "Multiplayer").
// Two custom domains hand neonstickfight.com and www.neonstickfight.com to this Worker (Cloudflare
// makes their DNS records and certificates); www gets a 301 to the bare domain. Static files come from
// the assets binding (dist/, file path = URL path, vite build fills it). The script runs first for
// /api/* (quick rooms and crew rooms, one Durable Object each; profiles and email sign-in in D1; see
// worker/index.ts), for a crew's or a room's own link (crew/<slug>, room/<CODE>: the game page with
// the room's share tags, worker/og.ts) and for every page, so it can send www away and 301 old ?crew= links; the
// pages' scripts, styles and pictures never wake it. Anything else the assets don't have gets a 404.
//
// The old address, askscottpierce.com/stick-fight, keeps its two zone routes on the same Worker (no
// path in dist/ starts with /stick-fight, so all of it reaches the script; wrangler warns that these
// routes "will attempt to serve Assets on a configured path" on every deploy, and that's expected). OLD_PATH says what it does:
// "serve" the game there as before, or "redirect" every page to the same one here with a 301. Flip it
// to "redirect" once neonstickfight.com is checked (README, Hosting, Moving day).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stick-fight",
  "account_id": "0223b96fe77599b23ff8ec7fcd32e2f1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "neonstickfight.com", "custom_domain": true },
    { "pattern": "www.neonstickfight.com", "custom_domain": true },
    { "pattern": "askscottpierce.com/stick-fight", "zone_name": "askscottpierce.com" },
    { "pattern": "askscottpierce.com/stick-fight/*", "zone_name": "askscottpierce.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: console output and one log per request, searchable in the dashboard; traces stay off
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // /play redirects to /play/, so the page's relative ./src/... paths resolve
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // the API, crew/ and room/ links, and the pages (every HTML file in dist/ is one of these); everything else is served without the script
    "run_worker_first": ["/api/*", "/", "/index.html", "/play", "/play/*", "/fighters", "/fighters/*", "/how-to-play", "/how-to-play/*", "/crew/*", "/room/*"]
  },
  "durable_objects": {
    // ROOMS: one per quick room, named by its four-letter code (worker/index.ts).
    // CREWS: one per crew room, named by its slug; keeps the crew's members and records in its
    // own SQLite storage (worker/crew.ts)
    // LOBBY: one object, named "live": the LIVE list of quick matches anyone may watch (kept in its storage, two or three writes a match)
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "CREWS", "class_name": "Crew" }, { "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Crew"] }, { "tag": "v3", "new_sqlite_classes": ["Lobby"] }],
  // Profiles kept by email (worker/auth.ts): accounts, sign-in codes (hashed), sessions (hashed),
  // and the send and guess counters. The match bookkeeping's all-time rollups live here too
  // (worker/stats.ts, migrations/0003_stats.sql): fighters and modes only, no player in them. Schema in migrations/; apply with
  // `npx wrangler d1 migrations apply stick-fight-auth --remote` before the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "stick-fight-auth", "database_id": "8a0ea2d9-9d74-466f-a6ff-5a0446d35653", "migrations_dir": "migrations" }
  ],
  // Sign-in codes go out from hey@askscottpierce.com (Email Sending is set up on the zone)
  "send_email": [{ "name": "EMAIL" }],
  // OLD_PATH: "serve" | "redirect", what askscottpierce.com/stick-fight does (see the top of this file)
  "vars": { "EMAIL_FROM": "hey@askscottpierce.com", "OLD_PATH": "serve" },
  // Abuse limits per client IP (worker/index.ts clientKey), counted per Cloudflare location.
  // Free on every plan; the period can only be 10 or 60 seconds. namespace_id must be unique on
  // the account (other projects use 1001-1003).
  "ratelimits": [
    { "name": "ROOM_LIMIT", "namespace_id": "7101", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    // new crew rooms per IP
    { "name": "CREW_LIMIT", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } },
    // profile and sign-in calls per IP (the per-email and per-hour caps live in D1)
    { "name": "AUTH_LIMIT", "namespace_id": "7104", "simple": { "limit": 20, "period": 60 } },
    // analytics events per IP (POST /api/e)
    { "name": "EVENT_LIMIT", "namespace_id": "7105", "simple": { "limit": 60, "period": 60 } },
    // GET /api/stats per IP (the answer is cached at the edge, so this only guards the limiter itself)
    { "name": "STATS_LIMIT", "namespace_id": "7106", "simple": { "limit": 60, "period": 60 } },
    // share images drawn per IP (api/og/..., worker/og.ts); one served from the edge cache doesn't count
    { "name": "OG_LIMIT", "namespace_id": "7107", "simple": { "limit": 20, "period": 60 } },
    // career calls per IP (api/career: a finished offline match, a purchase, the guest merge; worker/career.ts)
    { "name": "CAREER_LIMIT", "namespace_id": "7108", "simple": { "limit": 40, "period": 60 } }
  ],
  // Game analytics (Workers Analytics Engine): cookieless events, no player ids; query with the
  // SQL API (README, Analytics). The dataset is created on the first write.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "stick_fight_events" }]
}
