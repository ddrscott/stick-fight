// Static Worker serving the game at https://askscottpierce.com/stick-fight (see README, "Hosting").
// No Worker script: the routes hand /stick-fight and /stick-fight/* to the assets, which
// live under dist/stick-fight/ so the file path equals the URL path. scripts/build.sh fills it.
{
  "name": "stick-fight",
  "account_id": "0223b96fe77599b23ff8ec7fcd32e2f1",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "askscottpierce.com/stick-fight", "zone_name": "askscottpierce.com" },
    { "pattern": "askscottpierce.com/stick-fight/*", "zone_name": "askscottpierce.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    // /stick-fight redirects to /stick-fight/, so the page's relative ./src/... paths resolve
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
