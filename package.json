{
  "name": "stick-fight",
  "private": true,
  "version": "0.1.0",
  "description": "A neon browser stick-figure fighting game",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "vite build && wrangler deploy",
    "netsim": "node scripts/netsim/run.mjs",
    "netsim:proof": "node scripts/netsim/proof.mjs",
    "netsim:watch": "node scripts/netsim/watch.mjs",
    "test:watch": "node scripts/watch/e2e.mjs",
    "test:qr": "node scripts/qr/check.mjs",
    "test:join": "node scripts/join/check.mjs",
    "test:ios": "node scripts/ios/check.mjs",
    "test:movelist": "node scripts/movelist/check.mjs",
    "test:horde": "node scripts/horde/check.mjs",
    "test:select": "node scripts/select/check.mjs",
    "test:square": "node scripts/shots/portrait.mjs --check --only 390x844,412x915,375x667,395x700,412x640 --out gauntlet/tmp/portrait && node scripts/shots/square-fit.mjs",
    "test:unfurl": "node scripts/og/check.mjs",
    "test:move": "node scripts/move/check.mjs",
    "test:crew": "node scripts/crew/check.mjs && node scripts/crew/lobby.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.20.5",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
