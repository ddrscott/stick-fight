{
  "name": "stick-fight",
  "private": true,
  "version": "0.1.0",
  "description": "A neon browser stick-figure fighting game",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "vite build && wrangler deploy",
    "netsim": "node scripts/netsim/run.mjs",
    "netsim:proof": "node scripts/netsim/proof.mjs",
    "netsim:watch": "node scripts/netsim/watch.mjs",
    "netsim:invariants": "node scripts/netsim/invariants.mjs",
    "test:invariants:scenes": "node scripts/netsim/invariants-scenes.mjs",
    "test:watch": "node scripts/watch/e2e.mjs",
    "test:qr": "node scripts/qr/check.mjs",
    "test:join": "node scripts/join/check.mjs",
    "test:ios": "node scripts/ios/check.mjs",
    "test:movelist": "node scripts/movelist/check.mjs",
    "test:horde": "node scripts/horde/check.mjs",
    "test:ko": "node scripts/ko/guard.mjs",
    "test:books": "node scripts/books/flow.mjs",
    "test:books:worker": "node scripts/books/worker.mjs",
    "test:select": "node scripts/select/check.mjs",
    "test:square": "node scripts/shots/portrait.mjs --check --only 390x844,412x915,375x667,395x700,412x640 --out gauntlet/tmp/portrait && node scripts/shots/square-fit.mjs",
    "test:unfurl": "node scripts/og/check.mjs",
    "test:move": "node scripts/move/check.mjs",
    "test:crew": "node scripts/crew/check.mjs && node scripts/crew/lobby.mjs",
    "test:names": "node scripts/names/check.mjs",
    "test:admin": "node scripts/admin/check.mjs",
    "test:delete": "node scripts/delete/check.mjs",
    "test:delete:ui": "node scripts/delete/ui.mjs",
    "test:support": "node scripts/support/check.mjs",
    "test:age": "node scripts/age/check.mjs",
    "test:career": "node scripts/career/rules.mjs",
    "test:career:worker": "node scripts/career/worker.mjs",
    "test:career:ui": "node scripts/career/ui.mjs",
    "test:device": "node scripts/perf/device.mjs",
    "test:closet": "node scripts/career/closet.mjs",
    "test:closet:ui": "node scripts/career/closet-ui.mjs",
    "test:closet:link": "node scripts/career/closet-link.mjs",
    "test:pto": "node scripts/career/pto.mjs",
    "test:pto:ui": "node scripts/career/pto-ui.mjs",
    "test:shifts": "node scripts/career/shifts.mjs",
    "test:shifts:ui": "node scripts/career/shifts-ui.mjs",
    "test:mastery": "node scripts/career/mastery.mjs",
    "test:upgrades": "node scripts/career/upgrades.mjs",
    "test:upgrades:worker": "node scripts/career/upgrades-worker.mjs",
    "test:upgrades:ui": "node scripts/career/upgrades-ui.mjs",
    "test:mastery:ui": "node scripts/career/mastery-ui.mjs",
    "test:moves": "node scripts/career/moves.mjs",
    "test:moves:worker": "node scripts/career/moves-worker.mjs",
    "test:moves:ui": "node scripts/career/moves-ui.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.20.5",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
