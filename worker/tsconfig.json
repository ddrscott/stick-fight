{
  // The Worker (worker/index.ts) type-checks on its own: Workers runtime types, no DOM.
  // worker-configuration.d.ts comes from `npx wrangler types worker/worker-configuration.d.ts`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    // worker/og-layout.ts imports og-metrics.ts by its full name, so Node can load it for scripts/og/check.mjs
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    // src/net/watchlog.js is shared with the pages (plain JavaScript, typed by inference)
    "allowJs": true
  },
  "include": ["*.ts"]
}
